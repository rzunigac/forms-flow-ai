<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <title>formsflow.ai</title>
  <script src="/config/config.js"></script>
  <link rel="stylesheet" href="<%= vendor %>/@bpmn-io/properties-panel@3.48.0/dist/assets/properties-panel.css">

  <!-- required dmn modeler styles -->
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/diagram-js.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-js-shared.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-js-drd.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-js-decision-table.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-js-decision-table-controls.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-js-literal-expression.css">
  <link rel="stylesheet" href="<%= vendor %>/dmn-js@16.8.0/dist/assets/dmn-font/css/dmn.css">
  <!-- Base theme: written at container start (the bundled theme, or one mounted by the deployment). -->
  <link rel="stylesheet" href="/config/theme.css">

  <!-- required styles from cdn -->
  <link rel="stylesheet" href="<%= vendor %>/@fontsource/nunito-sans@5.3.0/400.css">
  <link rel="stylesheet" href="<%= vendor %>/@fontsource/nunito-sans@5.3.0/600.css">
  <link rel="stylesheet" href="<%= vendor %>/@fontsource/nunito-sans@5.3.0/700.css">
  <link rel="stylesheet" href="<%= vendor %>/formiojs@4.13.1/dist/formio.full.min.css">
  <link rel="stylesheet" href="<%= vendor %>/@fortawesome/fontawesome-free@6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
 
  <!-- ✅ Formio Vendor Styles -->
  <link rel="stylesheet" href="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/flatpickr.min.css">
  <link rel="stylesheet" href="<%= formioCdn %>/shortcut-buttons-flatpickr/0.4.0/themes/light.min.css"> <!--TODO need to override this style internally @formsflow/theme-->
  <link rel="stylesheet" href="<%= vendor %>/formiojs@4.13.1/dist/formio.full.min.css">
  <!-- ✅ Flatpickr Locales -->
  <!-- NOTE: Load these only if needed — optimize in future -->
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-zh.js"></script>
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-pt.js"></script>
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-fr.js"></script>
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-bg.js"></script>
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-de.js"></script>
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/l10n/flatpickr-es.js"></script>

  <!-- ✅ Flatpickr & Shortcut Buttons JS -->
  <script src="<%= formioCdn %>/flatpickr-formio/4.6.13-formio.3/flatpickr.min.js"></script>
  <script src="<%= formioCdn %>/shortcut-buttons-flatpickr/0.4.0/shortcut-buttons-flatpickr.min.js"></script>

  <!-- ✅ CKEditor (used in formio WYSIWYG) -->
  <script src="<%= formioCdn %>/ckeditor/19.0.0/ckeditor.js"></script>
  <!-- Quill (Text Area editor "Quill"): loaded before SystemJS. Loaded later by formio, its UMD wrapper finds
       SystemJS's AMD define() and registers a module instead of window.Quill, so the editor never renders. -->
  <script src="<%= formioCdn %>/quill/2.0.0-dev.3/quill.min.js"></script>


  <!--
    Remove this if you only support browsers that support async/await.
    This is needed by babel to share largeish helper code for compiling async/await in older
    browsers. More information at https://github.com/single-spa/create-single-spa/issues/112
  -->
  <script src="<%= vendor %>/regenerator-runtime@0.13.7/runtime.js"></script>

  <meta name="importmap-type" content="systemjs-importmap" />
  <!-- If you wish to turn off import-map-overrides for specific environments (prod), uncomment the line below -->
  <!-- More info at https://github.com/joeldenning/import-map-overrides/blob/master/docs/configuration.md#domain-list -->
  <!-- <meta name="import-map-overrides-domains" content="denylist:prod.example.com" /> -->

  <!-- Shared dependencies go into this import map. Your shared dependencies must be of one of the following formats:

    1. System.register (preferred when possible) - https://github.com/systemjs/systemjs/blob/master/docs/system-register.md
    2. UMD - https://github.com/umdjs/umd
    3. Global variable

    More information about shared dependencies can be found at https://single-spa.js.org/docs/recommended-setup#sharing-with-import-maps.
  -->
  <script type="systemjs-importmap">
    {
      "imports": {
        "single-spa": "<%= vendor %>/single-spa@5.9.0/lib/system/single-spa.min.js"
      }
    }
  </script>
  <link rel="preload" href="<%= vendor %>/single-spa@5.9.0/lib/system/single-spa.min.js" as="script">

  <% if (!isLocal) { %>
  <!-- Written at container start: same-origin bundles by default, overrides only from deploy config. -->
  <script type="systemjs-importmap" src="/config/importmap.json"></script>
  <% } else { %>
     <script type="systemjs-importmap">
        {
          "imports": {
              "@formsflow/root-config": "/formsflow-root-config.js",
              "@formsflow/nav": "<%= process.env.MF_FORMSFLOW_NAV_URL %>",
              "@formsflow/formsflow-web": "<%= process.env.MF_FORMSFLOW_WEB_URL %>",
              "@formsflow/admin":"<%=process.env.MF_FORMSFLOW_ADMIN_URL %>",
              "@formsflow/task":"<%=process.env.MF_FORMSFLOW_REVIEW_URL %>",
              "@formsflow/submissions":"<%=process.env.MF_FORMSFLOW_SUBMISSIONS_URL %>",
              "@formsflow/service":"<%= process.env.MF_FORMSFLOW_SERVICE_URL %>",
              "@formsflow/components":"<%= process.env.MF_FORMSFLOW_COMPONENTS_URL %>"
          }
        }
      </script>
  <% } %>
    <% if (isLocal) { %>
      <script type="systemjs-importmap">
        {
          "imports": {
            "react": "https://cdn.jsdelivr.net/npm/react@17.0.2/umd/react.development.js",
            "react-dom": "https://cdn.jsdelivr.net/npm/react-dom@17.0.2/umd/react-dom.development.js"
          }
        }
      </script>
      <% } else { %>
        <script type="systemjs-importmap">
          {
            "imports": {
              "react": "<%= vendor %>/react@17.0.2/umd/react.production.min.js",
              "react-dom": "<%= vendor %>/react-dom@17.0.2/umd/react-dom.production.min.js"
            }
          }
        </script>
    <% } %>

  <!--
    If you need to support Angular applications, uncomment the script tag below to ensure only one instance of ZoneJS is loaded
    Learn more about why at https://single-spa.js.org/docs/ecosystem-angular/#zonejs
  -->
  <!-- <script src="https://cdn.jsdelivr.net/npm/zone.js@0.11.3/dist/zone.min.js"></script> -->

  <% if (!isLocal) { %>
  <!-- Before any bundle: formio loads its editors and widgets from /vendor/formio/, not cdn.form.io. -->
  <script src="/formio-cdn.js"></script>
  <% } %>
  <% if (isLocal) { %>
  <!-- Development only: overrides in localStorage can swap any MFE for arbitrary code (report 08 S2). -->
  <script src="https://cdn.jsdelivr.net/npm/import-map-overrides@2.2.0/dist/import-map-overrides.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/systemjs@6.8.3/dist/system.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/systemjs@6.8.3/dist/extras/amd.js"></script>
  <% } else { %>
  <script src="<%= vendor %>/systemjs@6.8.3/dist/system.min.js"></script>
  <script src="<%= vendor %>/systemjs@6.8.3/dist/extras/amd.min.js"></script>
  <% } %>

</head>
<body>
  <noscript>
    You need to enable JavaScript to run this app.
  </noscript>
  <script src="/start.js"></script>
  <% if (isLocal) { %>
  <import-map-overrides-full show-when-local-storage="devtools" dev-libs></import-map-overrides-full>
  <% } %>
</body>
</html>
